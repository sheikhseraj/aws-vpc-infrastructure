      "versionNonce": 624601239,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785937492280,
      "link": null,
      "locked": false,
      "text": "Terraform (Cool) and I would make everything OPEN SOURCE\n\nWapper functions:\n\nresource \"aws_instance\" \"example\" {\n  ami           = \"resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64\"\n  instance_type = \"t3.micro\"\n\n  tags = {\n    Name = \"nf-instance\"\n  }\n}\n ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Terraform (Cool) and I would make everything OPEN SOURCE\n\nWapper functions:\n\nresource \"aws_instance\" \"example\" {\n  ami           = \"resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64\"\n  instance_type = \"t3.micro\"\n\n  tags = {\n    Name = \"nf-instance\"\n  }\n}\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PmzLiSpIqYqf4Kke4Gxk3",
      "type": "text",
      "x": 571.1364980364655,
      "y": 1933.7932796436799,
