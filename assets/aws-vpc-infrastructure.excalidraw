    {
      "id": "4LYMfRMUgKQZolRmF2qCJ",
      "type": "text",
      "x": 2972.1695804404294,
      "y": 1882.4914057757692,
      "width": 673.9795532226562,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fd7e1488",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5G",
      "roundness": null,
      "seed": 611034536,
      "version": 486,
      "versionNonce": 1648906456,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786184386118,
      "link": null,
      "locked": false,
      "text": "Serj Requirement is he wants => 60 IP'S for this system.\nWe do the maths:\n2^(32-n) = n? \n\nOctet idea:\n192.168.0.0 -> 255\n192.168.0.255 -> 192.168.1.255 -> 192.168.2.255 ... 192.168.255.255\n\nif we want 64 IP's => then we will get 64-5 = 59",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Serj Requirement is he wants => 60 IP'S for this system.\nWe do the maths:\n2^(32-n) = n? \n\nOctet idea:\n192.168.0.0 -> 255\n192.168.0.255 -> 192.168.1.255 -> 192.168.2.255 ... 192.168.255.255\n\nif we want 64 IP's => then we will get 64-5 = 59",
      "autoResize": true,
      "lineHeight": 1.25
    },
