    {
      "id": "v-WlhyfMbxqHmDh82eHGT",
      "type": "text",
      "x": 3556.676196066664,
      "y": 1663.208879408535,
      "width": 432.8797607421875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "#fd7e1488",
