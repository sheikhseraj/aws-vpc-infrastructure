      "versionNonce": 549218169,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785937492280,
      "link": null,
      "locked": false,
      "text": "Terraform is ? HCL -> Hashi corp Language\nProvisioning tool  -> Creating resource -> EC2, S3, DynamodB, Cloud Watch ..\n\nBash.sh\n\naws ec2 run-instances \\\n    --image-id ami-0abcdef1234567890 \\\n    --instance-type t2.micro \\\n    --key-name MyKeyPair\n    -- tag-sepcifition \"ResourceType=vpc, Tags[{key=Name, Value \"nf-instance\"}]\"\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Terraform is ? HCL -> Hashi corp Language\nProvisioning tool  -> Creating resource -> EC2, S3, DynamodB, Cloud Watch ..\n\nBash.sh\n\naws ec2 run-instances \\\n    --image-id ami-0abcdef1234567890 \\\n    --instance-type t2.micro \\\n    --key-name MyKeyPair\n    -- tag-sepcifition \"ResourceType=vpc, Tags[{key=Name, Value \"nf-instance\"}]\"\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bLQ_mMZspqAo8rEG7vVz5",
      "type": "text",
      "x": 572.2830085222091,
      "y": 1613.987509739355,
      "width": 984.8392944335938,
      "height": 325,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
