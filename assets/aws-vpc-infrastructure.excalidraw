      "boundElements": [],
      "updated": 1785919355457,
      "link": null,
      "locked": false,
      "text": "Bash.sh\n\naws ec2 run-instances \\\n    --image-id ami-0abcdef1234567890 \\\n    --instance-type t2.micro \\\n    if (\"something\"= \"Yes\", -z); then \n        --key-name -> WENT WRONG \n    fi\n    -- tag-sepcifition \"ResourceType=vpc, Tags[{key=Name, Value \"nf-instance\"}]\"\n\nTerraform . Memory (local, remote) - Syntax checking (run-time)\nresource \"aws_instance\" \"example\" {\n  ami           = \"resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64\"\n  instance_type = \"t3.micro\"\n\n  tags = {\n    Name = \"nf-instance\"\n  }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bash.sh\n\naws ec2 run-instances \\\n    --image-id ami-0abcdef1234567890 \\\n    --instance-type t2.micro \\\n    if (\"something\"= \"Yes\", -z); then \n        --key-name -> WENT WRONG \n    fi\n    -- tag-sepcifition \"ResourceType=vpc, Tags[{key=Name, Value \"nf-instance\"}]\"\n\nTerraform . Memory (local, remote) - Syntax checking (run-time)\nresource \"aws_instance\" \"example\" {\n  ami           = \"resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64\"\n  instance_type = \"t3.micro\"\n\n  tags = {\n    Name = \"nf-instance\"\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Hsi6uNOHY6S-uKzBpcvt-",
      "type": "text",
      "x": 1676.7388060516398,
