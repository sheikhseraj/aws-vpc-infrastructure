      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6U",
      "roundness": null,
      "seed": 799018664,
      "version": 61,
      "versionNonce": 644082392,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786184142937,
      "link": null,
      "locked": false,
      "text": "Why does the CIDR starts with /16?\nNetworking : 0.0.0.0/16 -> 32\nFormula: 2^(32-n) = what is n? => 2^(32-16)\n2^(16) = 65.536 IP'S",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why does the CIDR starts with /16?\nNetworking : 0.0.0.0/16 -> 32\nFormula: 2^(32-n) = what is n? => 2^(32-16)\n2^(16) = 65.536 IP'S",
      "autoResize": true,
      "lineHeight": 1.25
    },
